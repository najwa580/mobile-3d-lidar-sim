<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="base_length" value="0.25" />
    <xacro:property name="base_width" value="0.18" />
    <xacro:property name="base_height" value="0.065" />
    <xacro:property name="wheel_radius" value="0.065" />
    <xacro:property name="wheel_length" value="0.06" />
    <xacro:property name="base_mass" value="5.0" />
    <xacro:property name="wheel_mass" value="1.0" />
    <xacro:property name="base_z_footprint" value="0.03" />

    <link name="base_footprint" />

    <link name="base_link">
        <visual>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
            <origin xyz="0 0 0.03" rpy="0 0 0" />
            <material name="blue" />
        </visual>
        <collision>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
            <origin xyz="0 0 0.03" rpy="0 0 0" />
        </collision>
        <xacro:box_inertia m="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}"
                           o_xyz="0 0 0.03" o_rpy="0 0 0" />
    </link>

    <xacro:macro name="wheel_link" params="prefix">
        <link name="${prefix}_wheel_link">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}" />
                </geometry>
                <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
                <material name="grey" />
            </visual>
            <collision>
                <geometry>
                    <sphere radius="${wheel_radius}" />
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0" />
            </collision>
            <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" l="${wheel_length}"
                                    o_xyz="0 0 0" o_rpy="${pi / 2.0} 0 0" />
        </link>
    </xacro:macro>

    <xacro:wheel_link prefix="right_back" />
    <xacro:wheel_link prefix="left_back" />
    <xacro:wheel_link prefix="right_front" />
    <xacro:wheel_link prefix="left_front" />

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 ${base_z_footprint}" rpy="0 0 0"/>
    </joint>

    <joint name="base_right_back_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="right_back_wheel_link" />
        <origin xyz="${-base_length / 2.0} ${-(base_width + wheel_length) / 2.0 - 0.01} ${wheel_radius / 2.0}" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit effort="10.0" velocity="10.0"/>
        <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <joint name="base_left_back_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="left_back_wheel_link" />
        <origin xyz="${-base_length / 2.0} ${(base_width + wheel_length) / 2.0 + 0.01} ${wheel_radius / 2.0}" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit effort="10.0" velocity="10.0"/>
        <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <joint name="base_right_front_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="right_front_wheel_link" />
        <origin xyz="${base_length / 2.0} ${-(base_width + wheel_length) / 2.0 - 0.01} ${wheel_radius / 2.0}" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit effort="10.0" velocity="10.0"/>
        <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <joint name="base_left_front_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="left_front_wheel_link" />
        <origin xyz="${base_length / 2.0} ${(base_width + wheel_length) / 2.0 + 0.01} ${wheel_radius / 2.0}" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit effort="10.0" velocity="10.0"/>
        <dynamics damping="0.1" friction="0.1"/>
    </joint>

</robot>